# Anyrest Web — NGINX serving pre-built React static files
#
# The React app is pre-built (web/dist/ is committed to the repo).
# This Dockerfile just copies the static files into NGINX — no npm,
# no Node.js, no network calls. Build time: ~5 seconds.
#
# To rebuild the web app after source changes (run locally, then commit):
#   cd web && npm install && npm run build && git add dist/ && git commit
FROM nginx:1.27-alpine

RUN rm /etc/nginx/conf.d/default.conf

COPY nginx/nginx.conf   /etc/nginx/nginx.conf
COPY web/dist           /usr/share/nginx/html

# Certificates are mounted at runtime via docker-compose.yml volumes:
#   - ./certs:/etc/nginx/certs:ro
# Required files: server.crt  server.key  ca.crt
EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
