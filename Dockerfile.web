# ─── Stage 1: Build the React web client ─────────────────────────────────────
FROM node:22-alpine AS web-builder

WORKDIR /app

COPY web/package*.json ./
RUN npm ci --prefer-offline

COPY web/ ./
# Build with the signal URL pointing to the same HTTPS host (wss://...)
# ANYREST_SIGNAL_URL can be overridden at build time if needed.
ARG ANYREST_SIGNAL_URL=
ENV ANYREST_SIGNAL_URL=${ANYREST_SIGNAL_URL}
RUN npm run build

# ─── Stage 2: NGINX serving static files ─────────────────────────────────────
FROM nginx:1.27-alpine

# Remove default NGINX config
RUN rm /etc/nginx/conf.d/default.conf

# Copy our custom config
COPY nginx/nginx.conf /etc/nginx/nginx.conf

# Copy built web assets
COPY --from=web-builder /app/dist /usr/share/nginx/html

# Certificates are mounted at runtime:
#   docker run -v /path/to/certs:/etc/nginx/certs:ro anyrest-web
# The mount point must contain:  server.crt  server.key

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
