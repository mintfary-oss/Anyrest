# Binaries (intermediate build dirs only; /bin/ at repo root is committed)
/server/bin/
/agent/bin/
*.exe

# Certificates (generated at runtime, do not commit private keys)
certs/*.pem
certs/*.key
certs/*.crt
!certs/.gitkeep

# Go
vendor/
*.test

# Node / Web
web/node_modules/
# web/dist is committed — server needs zero npm at deploy time

# IDE
.idea/
.vscode/
*.swp

# Docker volumes
data/
