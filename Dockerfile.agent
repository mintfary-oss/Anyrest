# ─── Stage 1: Build the Go agent binary ──────────────────────────────────────
FROM golang:1.26-alpine AS builder

# kbinani/screenshot uses gen2brain/shm which needs CGO (sys/shm.h).
# musl-dev provides all required C headers on Alpine.
RUN apk add --no-cache gcc musl-dev

WORKDIR /app

COPY agent/go.mod agent/go.sum ./
RUN go mod download

COPY agent/ ./
RUN CGO_ENABLED=1 GOOS=linux go build \
      -ldflags="-s -w" \
      -o /app/anyrest-agent \
      ./cmd/

# ─── Stage 2: Runtime image with X11 tools ───────────────────────────────────
FROM alpine:3.21

# xdotool — keyboard/mouse injection via X11 XTEST
# ca-certificates — for TLS connections
# update-ca-certificates — so entrypoint can install our CA
RUN apk add --no-cache \
      xdotool \
      ca-certificates

COPY --from=builder /app/anyrest-agent /usr/local/bin/anyrest-agent
COPY agent-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Mount /opt/anyrest/certs at runtime so the CA is auto-installed.
# Mount /tmp/.X11-unix for screen capture and input injection.
ENV DISPLAY=:0

ENTRYPOINT ["/entrypoint.sh"]
