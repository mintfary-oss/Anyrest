# Anyrest Desktop Agent
#
# Pre-built binary is committed to bin/linux-{amd64,arm64}/.
# No Go compiler, no CGO, no network calls — build time: ~10 seconds.
#
# To rebuild the binary after source changes (run locally, then commit):
#   cd agent
#   CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" \
#       -o ../bin/linux-amd64/anyrest-agent ./cmd/
#   (repeat with GOARCH=arm64 for ARM servers, then commit bin/)

FROM alpine:3.21

# TARGETARCH is injected by Docker for the target platform (amd64 | arm64 | …).
ARG TARGETARCH=amd64

# xdotool — keyboard/mouse injection via the X11 XTEST extension.
# ca-certificates — for outbound TLS/WSS connections.
RUN apk add --no-cache xdotool ca-certificates

# Copy the pre-built agent binary for the correct architecture.
COPY bin/linux-${TARGETARCH}/anyrest-agent /usr/local/bin/anyrest-agent
COPY agent-entrypoint.sh /entrypoint.sh
RUN chmod +x /usr/local/bin/anyrest-agent /entrypoint.sh

# Mount /opt/anyrest/certs at runtime so our CA is trusted.
# Mount /tmp/.X11-unix for screen capture and xdotool input injection.
ENV DISPLAY=:0

ENTRYPOINT ["/entrypoint.sh"]
