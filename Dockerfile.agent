# Anyrest Desktop Agent
#
# Pre-built binary is committed to bin/linux-{amd64,arm64}/.
# Requires xdotool for X11 input injection — installed via apk.
#
# Alpine mirror: Yandex (mirror.yandex.ru) — работает в России без блокировок.
# Если Yandex mirror недоступен, apk fallback-нет на основной Alpine CDN.
#
# Для пересборки бинарника:
#   cd agent
#   CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" \
#       -o ../bin/linux-amd64/anyrest-agent ./cmd/

FROM alpine:3.21

ARG TARGETARCH=amd64

# Используем зеркало Yandex вместо dl-cdn.alpinelinux.org (работает в России).
# Если Yandex недоступен — убрать строки с --repository и Alpine найдёт зеркало сам.
RUN echo "https://mirror.yandex.ru/mirrors/alpine/v3.21/main" > /etc/apk/repositories && \
    echo "https://mirror.yandex.ru/mirrors/alpine/v3.21/community" >> /etc/apk/repositories && \
    apk add --no-cache xdotool ca-certificates

COPY bin/linux-${TARGETARCH}/anyrest-agent /usr/local/bin/anyrest-agent
COPY agent-entrypoint.sh /entrypoint.sh
RUN chmod +x /usr/local/bin/anyrest-agent /entrypoint.sh

ENV DISPLAY=:0

ENTRYPOINT ["/entrypoint.sh"]
