# Anyrest Signal / Relay Server
#
# Pre-built binaries are committed to bin/linux-{amd64,arm64}/.
# Base image: busybox:1.37-musl — НЕТ apk add, НЕТ сетевых запросов при сборке.
#
# Почему busybox вместо alpine:
#   alpine требует `apk add ca-certificates wget` → скачивает с dl-cdn.alpinelinux.org
#   В России этот CDN часто недоступен → зависание на 30+ минут.
#   busybox:1.37-musl уже содержит wget и nc (applets) — apk не нужен.
#   signal/relay — серверы, не делают исходящих TLS соединений → ca-certificates не нужны.
#   Бинарник CGO_ENABLED=0 — полностью статический, работает без libc.
#
# Время сборки: ~3 секунды (только COPY + chmod).
#
# Для пересборки бинарников:
#   cd server
#   CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" \
#       -o ../bin/linux-amd64/anyrest-signal ./cmd/signal/
#   CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" \
#       -o ../bin/linux-amd64/anyrest-relay  ./cmd/relay/

FROM busybox:1.37-musl

# CMD selects which binary: signal | relay  (set via docker-compose args)
ARG CMD=signal

# TARGETARCH is injected by Docker (amd64 | arm64). Default: amd64.
ARG TARGETARCH=amd64

# No apk add — busybox already has wget and nc built-in.
COPY bin/linux-${TARGETARCH}/anyrest-${CMD} /anyrest-server
RUN chmod +x /anyrest-server

ENTRYPOINT ["/anyrest-server"]
