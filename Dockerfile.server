# ─── Stage 1: Build the Go server binary ─────────────────────────────────────
FROM golang:1.26-alpine AS builder

# CMD selects which server binary to build: signal | relay
ARG CMD=signal

WORKDIR /app

# Cache dependency downloads separately from source
COPY server/go.mod server/go.sum ./
RUN go mod download

COPY server/ ./
RUN CGO_ENABLED=0 GOOS=linux go build \
      -ldflags="-s -w" \
      -o /app/anyrest-server \
      ./cmd/${CMD}

# ─── Stage 2: Minimal Alpine runtime ─────────────────────────────────────────
# Using alpine (not scratch) so that healthcheck shell commands work.
FROM alpine:3.21

RUN apk add --no-cache ca-certificates wget

COPY --from=builder /app/anyrest-server /anyrest-server

ENTRYPOINT ["/anyrest-server"]
