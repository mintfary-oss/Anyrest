# ─── Stage 1: Build the Go server binary ─────────────────────────────────────
FROM golang:1.26-alpine AS builder

# CMD selects which server binary to build: signal | relay
ARG CMD=signal

WORKDIR /app

# Cache dependencies
COPY server/go.mod server/go.sum ./
RUN go mod download

# Build
COPY server/ ./
RUN CGO_ENABLED=0 GOOS=linux go build \
      -ldflags="-s -w" \
      -o /app/anyrest-server \
      ./cmd/${CMD}

# ─── Stage 2: Minimal runtime image ─────────────────────────────────────────
FROM scratch

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /app/anyrest-server /anyrest-server

ENTRYPOINT ["/anyrest-server"]
